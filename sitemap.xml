---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.lastmod | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
  {%- endfor %}
  {%- for indexed_page in site.pages %}
    {%- if indexed_page.sitemap == true and indexed_page.url != '/sitemap.xml' -%}
      {%- unless indexed_page.url contains '/page/' -%}
      {%- include canonical_url.html url=indexed_page.url -%}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ canonical_path }}</loc>
    {%- assign page_lastmod = indexed_page.last_modified_at | default: indexed_page.lastmod | default: indexed_page.date -%}
    {% if page_lastmod %}<lastmod>{{ page_lastmod | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor %}
</urlset>
